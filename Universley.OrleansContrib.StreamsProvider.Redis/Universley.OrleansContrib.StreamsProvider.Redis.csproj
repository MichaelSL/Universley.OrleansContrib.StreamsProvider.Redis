<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>Breaking: events are serialized with the Orleans serializer instead of System.Text.Json, and delivered to every subscriber whose stream type they are assignable to. Event types must be serializable by Orleans ([GenerateSerializer], or a fallback such as AddJsonSerializer). Earlier versions cannot read the new format: for a rolling deploy set RedisStreamReceiverOptions.PayloadFormat = Json until every silo and client is upgraded. Entries already in Redis are still delivered. Full notes and upgrade guidance: https://github.com/MichaelSL/Universley.OrleansContrib.StreamsProvider.Redis/blob/main/CHANGELOG.md</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Orleans.Streaming" Version="10.0.1" />
		<PackageReference Include="Microsoft.Orleans.Sdk" Version="10.0.1" />
		<PackageReference Include="StackExchange.Redis" Version="$(StackExchangeRedisVersion)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="RedisStreamsProvider.UnitTests" />
		<InternalsVisibleTo Include="RedisStreamsProvider.IntegrationTests" />
	</ItemGroup>

</Project>
